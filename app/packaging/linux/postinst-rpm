#!/bin/sh
set -e

# Automatically configure the WAIncognito RPM repository for DNF/YUM
REPO_DIR="/etc/yum.repos.d"
REPO_FILE="$REPO_DIR/waincognito.repo"
KEY_DIR="/etc/pki/rpm-gpg"
TARGET_KEY="$KEY_DIR/RPM-GPG-KEY-waincognito"

if [ -d "$REPO_DIR" ]; then
    # 1. Install or copy GPG public key
    KEY_FOUND=0
    for _candidate in \
        "/opt/waincognito/waincognito.asc" \
        "/opt/waincognito/resources/waincognito.asc" \
        "/opt/Whatsapp Incognito/waincognito.asc" \
        "/opt/Whatsapp Incognito/resources/waincognito.asc" \
        "$TARGET_KEY"; do
        if [ -f "$_candidate" ]; then
            mkdir -p "$KEY_DIR"
            if [ "$_candidate" != "$TARGET_KEY" ]; then
                cp "$_candidate" "$TARGET_KEY"
            fi
            chmod 644 "$TARGET_KEY"
            KEY_FOUND=1
            break
        fi
    done

    # 2. Write DNF/YUM repository entry
    if [ "$KEY_FOUND" -eq 1 ]; then
        cat << 'EOF' > "$REPO_FILE"
[waincognito]
name=WAIncognito Repository
baseurl=https://moodynooby.github.io/whatsapp-web-incognito/rpm/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-waincognito
       https://moodynooby.github.io/whatsapp-web-incognito/rpm/repodata/repomd.xml.key
EOF
    else
        cat << 'EOF' > "$REPO_FILE"
[waincognito]
name=WAIncognito Repository
baseurl=https://moodynooby.github.io/whatsapp-web-incognito/rpm/
enabled=1
gpgcheck=0
repo_gpgcheck=0
EOF
    fi

    chmod 644 "$REPO_FILE"
fi

# Fix Chromium SUID sandbox permissions for RPM-based distros (Fedora/RHEL/openSUSE)
for _dir in "/opt/Whatsapp Incognito" "/opt/waincognito"; do
    _sandbox="$_dir/chrome-sandbox"
    if [ -f "$_sandbox" ]; then
        chown root:root "$_sandbox"
        chmod 4755 "$_sandbox"
    fi
done
